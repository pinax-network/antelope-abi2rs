{
  "name": "antelope-abi2rs",
  "version": "0.4.1",
  "description": "Generate Rust type defenitions from Antelope ABI files",
  "author": "Yaro Shkvorets",
  "license": "MIT",
  "index": "dist/index.js",
  "bin": {
    "antelope-abi2rs": "dist/cli.js"
  },
  "files": [
    "dist/*"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/pinax-network/antelope-abi2rs"
  },
  "scripts": {
    "prepublishOnly": "bun run test && bun run build && chmod +x dist/cli.js",
    "build": "bun run clean && tsc",
    "pkg": "bun run distclean && bun run build && pkg dist/cli.js --output dist/antelope-abi2rs",
    "test": "tslint -p tsconfig.json -c tslint.json",
    "lint": "tslint -p tsconfig.json -c tslint.json -t stylish --fix",
    "clean": "rm -rf dist/",
    "distclean": "bun run clean && rm -rf node_modules/",
    "prebuild": "bun install --frozen-lockfile",
    "pretest": "bun install --frozen-lockfile",
    "predist": "bun install --frozen-lockfile"
  },
  "keywords": [
    "antelope",
    "abi",
    "rust"
  ],
  "dependencies": {
    "argparse": "^1.0.10"
  },
  "devDependencies": {
    "@types/argparse": "^1.0.10",
    "@types/node": "^18.15.6",
    "pkg": "^5.8.1",
    "tslint": "^6.1.3",
    "typescript": "^5.0.2"
  },
  "packageManager": "bun@1.4.3",
  "engines": {
    "bun": ">=1.4.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "onFail": "error"
    }
  }
}
